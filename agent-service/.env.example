# Copy to `.env` (gitignored) and fill in. Nothing here is committed.

# Shared secret for the X-Agent-Token header n8n sends on every call.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AGENT_SHARED_SECRET=

# Dev-only bypass when AGENT_SHARED_SECRET is unset. NEVER true in production.
# The service logs a loud warning on every request while this is on.
AGENT_ALLOW_NOAUTH=false

# Port the service listens on (default 8000).
AGENT_SERVICE_PORT=8000

# Production LLM path for the classifier + relevance filter. OFF by default
# (keyword baseline). Set AGENT_USE_LLM=true and provide a key to enable.
AGENT_USE_LLM=false
ANTHROPIC_API_KEY=
AGENT_LLM_MODEL=claude-haiku-4-5

# Postgres for decision logging (setter-memory schema: messages + decisions).
# Unset -> decisions are logged as JSON to stdout (acceptable for dev/demo).
DATABASE_URL=
