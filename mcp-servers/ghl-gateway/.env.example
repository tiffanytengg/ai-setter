# Copy to `.env` (gitignored) and fill in. Nothing here is committed.
# GHL private integration token, scoped to the sales sub-account (location).
GHL_PRIVATE_TOKEN=

# Location (sub-account) id the token is scoped to.
# Known sales sub-account location ID: eafTwojmWC6t3oMzK8va
GHL_LOCATION_ID=

# Master send switch. Anything other than exactly "true" (including empty)
# means NOTHING sends. Default: disabled.
SEND_ENABLED=false

# Comma-separated allowlist of GHL contact_ids (or contact phone numbers)
# allowed to receive test sends. EMPTY = nothing can send, ever.
# Example: SEND_ALLOWLIST=contact_abc123,+15551234567
SEND_ALLOWLIST=
