# Copy to `.env` (gitignored) and fill in. Nothing here is committed.
# This server is READ-ONLY BY DESIGN: there is no send tool and no send
# config here. The live send path is ghl-gateway.send_sms.

# Close API key — create at Close > Settings > API Keys.
# Basic auth: the key is the username, password is empty (handled in code).
CLOSE_API_KEY=

# Optional static booking-link map (JSON): {"user_or_org_id": "https://..."}
# or {"default": "https://..."} used for the demo when the API-key owner's
# user profile does not expose scheduling_links.main_setter.
BOOKING_LINK_MAP=
